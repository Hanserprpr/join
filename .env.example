ADMISSION_EMAIL_ENABLED=false
ADMISSION_EMAIL_POLL_DELAY_MS=5000
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL_ENABLED=true

# 头像存储：local 或 s3
AVATAR_STORAGE=local
AVATAR_LOCAL_DIRECTORY=./data/avatars
AVATAR_PUBLIC_BASE_URL=https://你的后端域名
AVATAR_MAX_SIZE_BYTES=2097152
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=11MB

# 海报：使用与头像相同的 local/s3 存储后端和 S3 凭证
POSTER_LOCAL_DIRECTORY=./data/posters
POSTER_PUBLIC_BASE_URL=https://你的后端域名
POSTER_MAX_SIZE_BYTES=10485760
# 额外允许写入部门资料的海报 URL 前缀，多个用逗号分隔
POSTER_ALLOWED_URL_PREFIXES=

# S3 兼容存储；AVATAR_STORAGE=s3 时必填
AVATAR_S3_ENDPOINT=http://minio:9000
AVATAR_S3_REGION=us-east-1
AVATAR_S3_ACCESS_KEY=
AVATAR_S3_SECRET_KEY=
AVATAR_S3_BUCKET=join
# 应包含 bucket 路径，例如 https://files.example.com/join；结尾不要加 avatars
AVATAR_S3_PUBLIC_BASE_URL=https://files.example.com/join
AVATAR_S3_PATH_STYLE_ACCESS=true

# ClamAV；启用后扫描失败会拒绝上传（fail closed）
# clamd.conf 的 StreamMaxLength 需大于 POSTER_MAX_SIZE_BYTES
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=2000
CLAMAV_READ_TIMEOUT_MS=5000

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_CALLBACK_URL=https://你的后端域名/api/wechat/binding/callback
WECHAT_BINDING_RESULT_URL=https://你的前端域名/wechat-binding
WECHAT_BINDING_STATE_TTL_SECONDS=600
WECHAT_BINDING_TEMPLATE_ID=Tw8ThFuRhgMOkrTirVHRnTPbxFdxyaFo2PIJdFqkxQw
WECHAT_INTERVIEW_CALL_TEMPLATE_ID=gmRpMS8vWvQuR02-tcVMp-lBRyH_qKelfziA3yKiRyY
# 服务号订阅通知模板 ID，多个用英文逗号分隔
WECHAT_SUBSCRIBE_TEMPLATE_IDS=
# 允许生成 JS-SDK 签名的前端 Origin，不要带路径
WECHAT_JS_SDK_ALLOWED_ORIGINS=https://你的前端域名
WECHAT_TICKET_REFRESH_AHEAD_SECONDS=300
WECHAT_SYSTEM_NAME=学生在线纳新系统
WECHAT_TOKEN_REFRESH_AHEAD_SECONDS=300

# 微信 API 出站 HTTP CONNECT 代理；端口请按实际代理服务修改
WECHAT_PROXY_ENABLED=false
WECHAT_PROXY_HOST=202.194.20.230
WECHAT_PROXY_PORT=8080
WECHAT_PROXY_CONNECT_TIMEOUT_MS=5000
WECHAT_PROXY_READ_TIMEOUT_MS=10000
